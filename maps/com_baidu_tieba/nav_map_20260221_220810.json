{
  "package": "com.baidu.tieba",
  "pages": {
    "home": {
      "name": "首页",
      "description": "浏览贴吧推荐内容和帖子列表",
      "features": [
        "下拉刷新",
        "内容卡片",
        "关注入口"
      ]
    },
    "mall": {
      "name": "小卖部步行街",
      "description": "浏览推荐商品和店铺",
      "features": [
        "活动横幅",
        "店铺入口",
        "商品列表"
      ]
    },
    "chat": {
      "name": "聊天列表",
      "description": "查看和管理聊天会话",
      "features": [
        "消息列表",
        "侧边栏贴吧导航"
      ]
    },
    "profile": {
      "name": "个人主页",
      "description": "查看用户个人信息、等级、发帖回帖数据及常用功能入口",
      "features": [
        "我的发帖",
        "我的回帖",
        "关注的吧",
        "我的收藏",
        "我的点赞",
        "浏览历史",
        "装扮中心",
