        "成长任务",
        "商品上新",
        "印记中心",
        "度小满钱包",
        "活动卡片"
      ]
    },
    "post_create": {
      "name": "发帖页面",
      "description": "创建并发布新帖子",
      "features": [
        "标题输入",
        "正文输入",
        "图片上传",
        "吧选择",
        "话题添加",
        "范围设置"
      ]
    },
    "search": {
      "name": "搜索页",
      "description": "贴吧搜索功能",
      "features": [
        "搜索历史",
        "快捷访问",
        "贴吧热榜",
        "实时热点"
      ]
    },
    "tieba_detail": {
      "name": "贴吧详情页",
      "description": "查看贴吧信息、聊天频道和帖子列表",
      "features": [
        "聊天频道入口",
        "帖子列表",
        "签到功能"
      ]
    },
    "community": {
      "name": "贴吧社区页面",
      "description": "浏览帖子、聊天交流、查看吧内信息",
      "features": [
        "下拉刷新",
        "帖子列表",
        "聊天频道入口",
        "签到按钮"
      ]
    },
    "forum_detail": {
      "name": "宫漫吧详情页",
      "description": "贴吧详情页面，展示吧内信息、聊天频道及帖子列表",
      "features": [
        "签到",
        "聊天频道入口",
        "帖子列表",
        "版块切换"
      ]
    }
