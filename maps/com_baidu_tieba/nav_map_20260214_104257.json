{
  "package": "com.baidu.tieba",
  "pages": {
    "home": {
      "name": "首页",
      "description": "展示个性化推荐的贴子内容流，包含顶部搜索、频道导航和底部功能导航。",
      "features": [
        "推荐贴子列表",
        "频道切换",
        "搜索功能",
        "发布功能",
        "底部导航栏"
      ]
    },
    "profile": {
      "name": "我的",
      "description": "个人信息展示、签到管理与关注的吧列表",
      "features": [
        "签到奖励、我的足迹、关注的吧列表、一键签到"
      ]
    },
    "explore": {
      "name": "进吧",
      "description": "展示用户足迹、已关注的贴吧列表以及推荐的吧单内容",
      "features": [
        "搜索吧",
        "一键签到",
        "查看关注列表",
        "浏览推荐吧单"
      ]
    },
    "canteen": {
      "name": "小卖部步行街",
      "description": "展示校园周边店铺、商品及促销活动",
      "features": [
        "搜索商品",
        "轮播广告",
        "店铺入口",
        "商品列表"
      ]
    },
    "notifications": {
      "name": "通知",
      "description": "查看各类互动消息、通知以及已加入的社区列表",
      "features": [
        "点赞回复分类",
        "社区侧边栏",
        "消息列表",
        "底部导航"
      ]
    },
    "post_editor": {
      "name": "发布页面",
      "description": "用户可以在此页面编辑并发布不同类型的帖子，包括文章、普通贴子、视频和求助内容。",
      "features": [
        "切换内容类型",
        "输入标题",
        "输入正文",
        "选择贴吧",
        "添加话题",
        "设置展示范围",
        "内容声明"
      ]
    },
    "detail": {
      "name": "贴子详情页",
      "description": "展示贴子正文内容及其下方的用户评论列表",
      "features": [
        "浏览正文",
        "查看评论",
        "发表回复",
        "跳转吧首页",
        "搜索"
      ]
    },
    "search": {
      "name": "搜索页",
      "description": "提供搜索功能，展示搜索历史、快捷访问的贴吧以及实时热点榜单",
      "features": [
        "搜索输入框",
        "搜索历史管理",
        "快捷访问贴吧",
        "实时热点排行榜",
        "软键盘输入"
      ]
    },
    "event_ranking": {
      "name": "贴吧活动排行榜",
      "description": "展示贴吧强厅赛活动荣耀值排名及规则",
      "features": [
        "查看排行榜",
        "查看规则"
      ]
    },
    "likes_list": {
      "name": "点赞列表",
      "description": "查看用户对自己回复的点赞历史记录",
      "features": [
        "返回按钮、点赞列表展示"
      ]
    },
    "message": {
      "name": "消息",
      "description": "展示私信、官方通知、AI智能体以及关注贴吧的动态快捷入口",
      "features": [
        "私信列表",
        "贴吧侧边栏",
        "发私信入口",
        "通知中心",
        "侧边栏管理"
      ]
    },
    "publish_select": {
      "name": "内容发布选择页",
      "description": "选择发布内容的类型及素材，当前处于视频选择状态",
      "features": [
        "切换发布类型",
        "拍照/录像",
        "选择本地视频素材"
      ]
    },
    "post_help": {
      "name": "发布求助",
      "description": "用户编辑求助帖子，可设置悬赏、选择贴吧及添加标签",
      "features": [
        "输入标题",
        "输入描述",
        "上传图片",
        "设置悬赏金额",
        "选择贴吧",
        "添加标签",
        "设置展示范围"
      ]
    },
    "edit": {
      "name": "发布页面",
      "description": "编辑并发布帖子、文章或视频内容",
      "features": [
        "标题输入",
        "正文输入",
        "选择发布贴吧",
        "添加话题",
        "设置展示范围",
        "内容声明"
      ]
    },
    "post_edit": {
      "name": "发布帖子",
      "description": "编写并发布新贴或文章的编辑页面",
      "features": [
        "标题输入",
        "正文内容编辑",
        "选择贴吧",
        "添加话题",
        "权限设置",
        "内容声明"
      ]
    },
    "editor": {
      "name": "发布编辑器",
      "description": "用户在此页面撰写并发布文章、贴子、视频或求助内容",
      "features": [
        "切换发布类型",
        "输入标题",
        "输入正文",
        "选择所属吧",
        "添加话题",
        "设置可见范围",
        "内容声明"
      ]
    },
    "spring_festival": {
      "name": "春节活动页",
      "description": "百度贴吧春节专题互动页面，包含春晚主持评分、春节热点资讯等功能",
      "features": [
        "顶部导航标签",
        "搜索",
        "发布按钮",
        "侧边栏菜单",
        "春晚主持评分列表",
        "更多打分入口",
        "年味资讯流",
        "底部导航栏"
      ]
    },
    "create_post": {
      "name": "发布贴子页",
      "description": "用于编辑和发布贴子，支持输入标题、正文、上传图片、选择所属贴吧及话题",
      "features": [
        "标题输入",
        "正文输入",
        "媒体上传",
        "选择吧",
        "添加话题",
        "展示范围设置"
      ]
    },
    "post_create": {
      "name": "发布页面",
      "description": "用户在此编辑并发布帖子、文章、视频或求助内容。",
      "features": [
        "标题输入",
        "正文输入",
        "媒体上传",
        "选择版块",
        "添加话题",
        "权限设置",
        "内容声明"
      ]
    },
    "video_record": {
      "name": "视频录制页",
      "description": "拍摄短视频，可添加音乐、滤镜和道具",
      "features": [
        "翻转摄像头",
        "选择滤镜",
        "选择音乐",
        "录制时长切换",
        "拍摄按钮",
        "选择道具",
        "进入相册"
      ]
    },
    "post_detail": {
      "name": "帖子详情页",
      "description": "浏览帖子的详细评论内容，并支持发表回复和跳转到吧首页",
      "features": [
        "评论列表",
        "排序切换",
        "回复发表",
        "查看子回复",
        "跳转吧首页"
      ]
    },
    "post_create_help": {
      "name": "发布求助",
      "description": "用户可以在此页面编辑并发布带有悬赏贴贝的求助内容，支持设置标题、详细描述、图片、悬赏金额、所属贴吧、标签及可见范围。",
