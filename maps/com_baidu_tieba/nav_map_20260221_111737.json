{
  "package": "com.baidu.tieba",
  "pages": {
    "home": {
      "name": "首页",
      "description": "浏览贴吧推荐内容",
      "features": [
        "下拉刷新",
        "内容卡片",
        "关注列表"
      ]
    },
    "detail": {
      "name": "帖子详情页",
      "description": "查看贴吧帖子详情及评论互动",
      "features": [
        "楼层列表",
        "楼主回复",
        "点赞功能"
      ]
    },
    "post_create": {
      "name": "发帖页面",
      "description": "发布新帖子内容",
      "features": [
        "标题输入",
        "正文编辑",
        "图片上传",
        "吧选择",
        "话题添加",
        "范围设置"
      ]
    },
    "forum_detail": {
      "name": "贴吧详情页",
      "description": "浏览贴吧帖子、参与讨论",
      "features": [
        "下拉刷新",
        "帖子列表",
        "签到入口"
      ]
    },
    "mall": {
      "name": "小卖部步行街",
      "description": "浏览和购买文具类商品",
      "features": [
        "活动横幅",
        "店铺入口",
        "商品列表",
        "价格展示"
      ]
    },
    "profile": {
      "name": "个人主页",
      "description": "查看用户信息、等级、发帖记录及常用功能入口",
      "features": [
        "我的发帖",
        "我的回帖",
        "关注的吧",
        "我的收藏",
        "我的点赞",
        "浏览历史",
        "装扮中心",
        "创建智能体",
        "成长任务",
        "商品上新",
        "印记中心",
        "度小满钱包",
        "活动卡片"
      ]
    },
    "post_detail": {
      "name": "帖子详情页",
      "description": "查看用户发布的帖子详情、图片及评论互动",
      "features": [
        "浏览帖子内容",
        "查看图片",
        "发表评论",
        "点赞"
      ]
    },
    "loan_promo": {
      "name": "度小满借钱活动页",
      "description": "现金红包领取及借款申请",
      "features": [
        "手机号输入",
        "验证码获取",
        "活动进度展示"
      ]
    },
    "expression_maker": {
      "name": "表情制作",
      "description": "AI图片编辑与风格转换工具",
      "features": [
        "图片预览",
        "功能按钮(修改文字/面部融合)",
        "文本输入框"
      ]
    },
    "notification": {
      "name": "通知中心",
      "description": "查看点赞、回复、@我的等互动消息",
      "features": [
        "消息列表",
        "分类筛选"
      ]
    },
    "comment_list": {
      "name": "评论区",
      "description": "查看帖子评论及回复",
      "features": [
        "下拉刷新",
        "评论列表",
        "点赞",
        "排序切换"
      ]
    },
    "scan": {
      "name": "扫一扫",
      "description": "扫描二维码/条形码",
      "features": [
        "自动扫描识别"
      ]
    }
