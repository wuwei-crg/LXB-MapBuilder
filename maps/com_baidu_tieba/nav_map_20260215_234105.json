{
  "package": "com.baidu.tieba",
  "pages": {
    "home": {
      "name": "首页",
      "description": "浏览推荐帖子内容、关注的吧动态及功能入口",
      "features": [
        "搜索",
        "顶部频道导航",
        "吧列表",
        "帖子信息流",
        "底部底部导航栏"
      ]
    },
    "home_featured": {
      "name": "首页-有料",
      "description": "展示当前的热门讨论、热点话题排行榜以及推荐贴吧，提供全局搜索和各功能版块的入口",
      "features": [
        "动态推选",
        "热点榜单",
        "贴吧推荐",
        "导航切换"
      ]
    },
    "event_page": {
      "name": "春节活动页",
      "description": "展示春节相关晚会评分、年味资讯及活动内容",
      "features": [
        "晚会评分列表",
        "年味聚焦资讯",
        "频道切换",
        "底部导航"
      ]
    },
    "forums": {
      "name": "进吧",
      "description": "提供搜索贴吧、管理关注、查看足迹及发现吧单的功能",
      "features": [
        "搜索贴吧",
        "一键签到",
        "查看足迹",
        "管理关注列表",
        "浏览吧单"
      ]
    },
    "shop_home": {
      "name": "小卖部",
      "description": "展示商品、推荐店铺及活动内容的商城聚合页",
      "features": [
        "搜索商品",
        "轮播活动广告",
        "进店跳转",
        "商品推荐列表"
      ]
    },
    "message": {
      "name": "消息",
      "description": "管理聊天记录、官方通知和互动信息",
      "features": [
        "消息列表",
        "AI智能体广场",
        "贴吧官方",
        "会员中心"
      ]
    },
    "profile": {
      "name": "个人中心",
      "description": "展示用户个人信息、互动统计、常用工具入口及增值服务",
      "features": [
        "互动数据统计",
        "常用功能入口",
        "成长任务",
        "会员特权",
        "钱包工具"
      ]
    },
    "live_home": {
      "name": "直播首页",
      "description": "展示贴吧内的直播内容及分类导航",
      "features": [
        "浏览直播列表",
        "切换分类",
        "搜索直播",
        "底部导航切换"
      ]
    },
    "bars": {
      "name": "进吧",
      "description": "浏览用户关注的贴吧和最近访问的足迹",
      "features": [
        "搜索框",
        "一键签到",
        "我的足迹列表",
        "我关注的吧列表",
        "底部导航栏"
      ]
    },
    "mall": {
      "name": "小麦部步行街",
      "description": "展示贴吧特色商品、特产及相关营销活动的商城页面",
      "features": [
        "商品搜索",
        "营销活动轮播图",
        "小卖部入口",
        "商品列表",
        "底部导航"
      ]
    },
    "message_select": {
      "name": "发私信-联系人选择",
      "description": "从关注列表中选择用户以发起私信对话",
      "features": [
        "搜索联系人",
        "浏览关注列表"
      ]
    },
    "chat_channel_selection": {
      "name": "选择聊天频道",
      "description": "允许用户浏览并选择已关注贴吧的聊天频道，将其添加到常用频道列表中进行快速访问。",
      "features": [
        "左侧常用频道侧边栏",
        "右侧可添加的聊天频道列表",
        "频道热度排行显示",
        "频道添加功能"
      ]
    },
    "avatar_editor": {
      "name": "个人装扮",
      "description": "编辑个人虚拟形象，可自定义发型、面部特征、服装、背景及心情等。",
      "features": [
        "角色预览",
        "发型分类切换",
        "捏脸编辑",
        "背景设置",
        "心情表达",
        "保存修改"
      ]
    },
    "search": {
      "name": "搜索页面",
      "description": "用户可以在该页面通过输入关键字搜索用户，并查看已关注的用户列表",
      "features": [
        "搜索输入框",
        "取消搜索",
        "查看关注列表",
        "软键盘输入"
      ]
    },
    "vip_center": {
      "name": "会员开通页",
      "description": "用户在此页面可以选择不同的会员套餐（如自动续费、12个月、3个月）以及支付方式（如支付宝、度小满），并确认协议进行支付以开通或续费会员服务。",
      "features": [
        "会员套餐选择",
        "支付方式选择",
        "协议确认",
        "会员特权展示",
        "SVIP切换"
      ]
    },
    "membership": {
      "name": "会员中心",
      "description": "展示会员套餐详情并提供开通/续费功能",
      "features": [
        "切换VIP/SVIP页签",
        "选择订阅套餐",
        "选择支付方式",
        "确认协议并支付",
        "查看会员特权"
      ]
    },
    "message_contact": {
      "name": "发私信",
      "description": "从关注列表中选择用户发送私信",
      "features": [
        "查看关注列表",
        "搜索联系人"
      ]
    }
