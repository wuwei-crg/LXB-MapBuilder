{
  "package": "com.taobao.taobao",
  "pages": {
    "home": {
      "name": "首页",
      "description": "浏览商品推荐、搜索商品、进入各功能模块（如：百亿补贴、淘宝秒杀等）",
      "features": [
        "搜索、分类频道、特价商品展示、商品流、底部导航"
      ]
    },
    "search": {
      "name": "搜索结果页",
      "description": "展示“高端小药盒”的商品搜索结果，支持筛选、排序及再次搜索",
      "features": [
        "商品列表展示",
        "关键词搜索",
        "拍照搜索",
        "排序筛选功能"
      ]
    },
    "scan": {
      "name": "扫码页",
      "description": "当前页面为扫码界面，用户可以通过摄像头扫描商品条码、快递单号或丰巢柜取件码。页面下方提供了相册入口，允许从本地图片中识别二维码。",
      "features": [
        "扫码识别",
        "拍照切换",
        "相册导入",
        "红包入口"
      ]
    },
    "message": {
      "name": "消息",
      "description": "展示各类交易物流、售后保障、优惠活动及互动消息，提供消息管理和搜索功能",
      "features": [
        "清除未读",
        "搜索",
        "通讯录",
        "发起聊天",
        "消息列表",
        "底部导航"
      ]
    },
    "cart": {
      "name": "购物车",
      "description": "显示购物车内的商品，提供管理、对比功能，空购物车时显示商品推荐。",
      "features": [
        "搜索",
        "对比",
        "管理",
        "降价/分组/常购/失效过滤",
        "推荐列表",
        "底部导航",
        "全选",
        "结算"
      ]
    },
    "profile": {
      "name": "我的淘宝",
      "description": "个人中心页面，展示用户资产、订单状态及各类功能入口",
      "features": [
        "个人信息",
        "资产(红包/优惠券/金币)",
        "订单追踪",
        "功能卡片(农场/游戏等)",
        "底部导航",
        "猜你喜欢商品推荐"
      ]
    },
    "following": {
      "name": "关注页",
      "description": "浏览已关注店铺的新品动态、兴趣内容",
      "features": [
        "搜索",
        "扫码",
        "切换频道",
        "浏览动态",
        "底部导航"
      ]
    },
    "list": {
      "name": "搜索结果页",
      "description": "展示根据关键词搜索到的商品列表，提供筛选、排序和反馈功能",
      "features": [
        "商品列表",
        "排序选项",
        "筛选标签",
        "搜索框",
        "拍照搜索"
      ]
    },
    "search_filter": {
      "name": "搜索筛选",
      "description": "对商品搜索结果进行多维度筛选，包括物流、优惠、评分、价格区间等",
      "features": [
        "地理位置修改",
        "物流筛选",
        "优惠筛选",
        "店铺评分筛选",
        "价格区间筛选",
        "清空选择",
        "确定"
      ]
    },
    "survey": {
      "name": "满意度调研",
      "description": "填写淘宝搜索结果满意度反馈问卷以获取奖励",
      "features": [
        "五星评分",
        "提交反馈"
      ]
    },
    "takeaway_home": {
      "name": "闪购外卖",
      "description": "提供外卖订餐、超市便利、看病买药等本地生活服务",
      "features": [
        "分类导航",
        "新人福利",
        "商家列表",
        "搜索",
        "底部导航"
      ]
    },
    "national_subsidy": {
      "name": "国补频道",
      "description": "浏览和购买政府补贴商品",
      "features": [
        "商品搜索",
        "分类浏览",
        "补贴商品列表",
        "活动横幅"
      ]
    },
    "fliggy_home": {
      "name": "飞猪频道页",
      "description": "飞猪旅游频道首页，提供酒店、机票、火车票、景点门票等预订服务及优惠活动",
      "features": [
        "搜索框",
        "分类入口",
        "领券活动",
        "底部导航"
      ]
    },
    "search_result": {
      "name": "搜索结果页",
      "description": "展示搜索到的商品列表，支持排序、筛选和跳转到详情或店铺",
      "features": [
        "搜索框",
        "分类标签",
        "排序筛选",
        "商品列表"
      ]
    },
    "video_feed": {
      "name": "视频推荐页",
      "description": "浏览推荐视频内容并支持查看相关商品",
      "features": [
        "视频播放",
        "点赞",
        "评论",
        "分享",
        "查看详情",
        "分类导航"
      ]
    },
    "activity_promotions": {
      "name": "活动优惠",
      "description": "展示活动优惠消息、红包提醒及根据搜索历史推荐的商品列表",
      "features": [
        "返回",
        "设置",
        "查看红包",
        "商品比价",
        "推荐商品跳转"
      ]
    },
    "followed_list": {
      "name": "关注店铺列表",
      "description": "浏览已关注的店铺，支持搜索、排序筛选及进入店铺操作",
      "features": [
        "搜索商品",
        "排序",
        "筛选",
        "店铺列表",
        "进入店铺"
      ]
    },
    "flash_sale": {
      "name": "淘宝秒杀",
      "description": "展示限时秒杀商品、大牌折扣及促销红包活动",
      "features": [
        "秒杀商品列表",
        "搜索",
        "品牌抢购",
        "红包领取"
      ]
    },
    "package_list": {
      "name": "菜鸟驿站",
      "description": "查看取件码、包裹状态及取件指引",
      "features": [
        "取件码展示",
        "身份码核验指引",
        "包裹详情查询",
        "底部导航"
      ]
    },
    "subsidies": {
      "name": "百亿补贴",
      "description": "浏览和领取百亿补贴活动中的商品及优惠券",
      "features": [
        "商品搜索",
        "领券中心",
        "补贴商品列表",
        "活动分类导航"
      ]
    },
    "search_list": {
      "name": "搜索结果页",
      "description": "展示搜索“迷你小药瓶”的商品列表，当前呼出了底部分享与功能菜单",
      "features": [
        "商品排序",
        "筛选",
        "商品展示",
        "分享",
        "快捷导航"
      ]
    }
